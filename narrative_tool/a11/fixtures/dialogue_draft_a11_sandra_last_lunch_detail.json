  "messages": [
    {"message_id": "m01", "speaker_id": "sandra", "kind": "TEXT", "text": "Je viens de retomber sur un grand moment de photographie.", "fact_refs": ["last_lunch_photo"], "beat_id": "ordinary_photo", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m02", "speaker_id": "sandra", "kind": "TEXT", "text": "Enfin… grand.", "fact_refs": [], "beat_id": "ordinary_photo", "branch": "COMMON", "burst_id": null, "strength": "WEAK", "media": null},
    {"message_id": "m03", "speaker_id": "marie", "kind": "TEXT", "text": "Je décline toute responsabilité artistique.", "fact_refs": ["lunch_photo_taken_by_marie"], "beat_id": "ordinary_photo", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m04", "speaker_id": "sandra", "kind": "IMAGE", "text": "La banquette, trois verres et les restes du déjeuner.", "fact_refs": ["last_lunch_photo"], "beat_id": "ordinary_photo", "branch": "COMMON", "burst_id": "burst_photo", "strength": "NORMAL", "media": {"media_id": "last_lunch_ordinary_photo", "kind": "PHOTO", "description": "Photo banale d'une table de déjeuner, sans pose ni mise en scène.", "justification": "La photo banale rend visible le verre fêlé et déclenche le souvenir partagé.", "linked_fact_id": "last_lunch_photo"}},
    {"message_id": "m05", "speaker_id": "sandra", "kind": "TEXT", "text": "Regardez mon verre.", "fact_refs": ["cracked_glass_detail"], "beat_id": "concrete_detail", "branch": "COMMON", "burst_id": "burst_photo", "strength": "NORMAL", "media": null},
    {"message_id": "m06", "speaker_id": "sandra", "kind": "TEXT", "text": "La petite étoile sur le bord 😅", "fact_refs": ["cracked_glass_detail"], "beat_id": "concrete_detail", "branch": "COMMON", "burst_id": "burst_photo", "strength": "NORMAL", "media": null},
    {"message_id": "m07", "speaker_id": "player", "kind": "TEXT", "text": "Je l'avais oubliée.", "fact_refs": ["cracked_glass_detail"], "beat_id": "concrete_detail", "branch": "COMMON", "burst_id": null, "strength": "WEAK", "media": null},
    {"message_id": "m08", "speaker_id": "marie", "kind": "TEXT", "text": "Moi non. J'avais peur qu'il finisse dans mon sac.", "fact_refs": ["cracked_glass_detail"], "beat_id": "concrete_detail", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m09", "speaker_id": "sandra", "kind": "TEXT", "text": "Tu avais surtout peur pour ton sac.", "fact_refs": ["cracked_glass_detail"], "beat_id": "concrete_detail", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m10", "speaker_id": "marie", "kind": "TEXT", "text": "C'est un très bon sac.", "fact_refs": [], "beat_id": "concrete_detail", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m11", "speaker_id": "player", "kind": "TEXT", "text": "Et les frites ont l'air encore plus tristes que dans mon souvenir.", "fact_refs": ["cold_fries_joke"], "beat_id": "shared_memory", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m12", "speaker_id": "sandra", "kind": "TEXT", "text": "Pardon, monsieur avait parlé de cuisson lente.", "fact_refs": ["cold_fries_joke"], "beat_id": "shared_memory", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m13", "speaker_id": "player", "kind": "TEXT", "text": "De repos gastronomique.", "fact_refs": ["cold_fries_joke"], "beat_id": "shared_memory", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m14", "speaker_id": "sandra", "kind": "TEXT", "text": "C'était pire que ce que j'avais gardé en tête.", "fact_refs": ["cold_fries_joke"], "beat_id": "shared_memory", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m15", "speaker_id": "marie", "kind": "TEXT", "text": "Et pourtant tu as fini l'assiette.", "fact_refs": ["cold_fries_joke"], "beat_id": "shared_memory", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m16", "speaker_id": "sandra", "kind": "TEXT", "text": "Je suis loyale dans l'adversité.", "fact_refs": ["cold_fries_joke"], "beat_id": "shared_memory", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m17", "speaker_id": "player", "kind": "TEXT", "text": "C'était un déjeuner assez nul, objectivement.", "fact_refs": ["last_lunch_photo"], "beat_id": "indirect_missing", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m18", "speaker_id": "player", "kind": "TEXT", "text": "Mais après c'était plus calme.", "fact_refs": ["last_lunch_photo"], "beat_id": "indirect_missing", "branch": "COMMON", "burst_id": "burst_missing", "strength": "NORMAL", "media": null},
    {"message_id": "m19", "speaker_id": "player", "kind": "TEXT", "text": "Un peu trop peut-être.", "fact_refs": ["last_lunch_photo"], "beat_id": "indirect_missing", "branch": "COMMON", "burst_id": "burst_missing", "strength": "NORMAL", "media": null},
    {"message_id": "m20", "speaker_id": "sandra", "kind": "TEXT", "text": "Tu fais une élégie aux frites molles maintenant ?", "fact_refs": ["cold_fries_joke"], "beat_id": "joke_misread", "branch": "COMMON", "burst_id": "burst_missing", "strength": "NORMAL", "media": null},
    {"message_id": "m21", "speaker_id": "sandra", "kind": "TEXT", "text": "Je savais que cette photo avait une vocation.", "fact_refs": ["last_lunch_photo"], "beat_id": "joke_misread", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m22", "speaker_id": "player", "kind": "TEXT", "text": "Pas les frites.", "fact_refs": ["cold_fries_joke"], "beat_id": "gentle_clarification", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m23", "speaker_id": "player", "kind": "TEXT", "text": "Le bruit autour.", "fact_refs": ["last_lunch_photo"], "beat_id": "gentle_clarification", "branch": "COMMON", "burst_id": null, "strength": "WEAK", "media": null},
    {"message_id": "m24", "speaker_id": "sandra", "kind": "TEXT", "text": "Ah.", "fact_refs": [], "beat_id": "gentle_clarification", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m25", "speaker_id": "marie", "kind": "TEXT", "text": "Je vous laisse une seconde avec la poésie du verre cassé.", "fact_refs": ["cracked_glass_detail"], "beat_id": "gentle_clarification", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m26", "speaker_id": "sandra", "kind": "TEXT", "text": "Il n'était pas cassé.", "fact_refs": ["cracked_glass_detail"], "beat_id": "gentle_clarification", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m27", "speaker_id": "player", "kind": "TEXT", "text": "Juste un peu marqué.", "fact_refs": ["cracked_glass_detail"], "beat_id": "gentle_clarification", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m28", "speaker_id": "sandra", "kind": "TEXT", "text": "Tu vas rendre ce pauvre verre beaucoup trop symbolique.", "fact_refs": ["cracked_glass_detail"], "beat_id": "attitude_choice", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m29", "speaker_id": "player", "kind": "TEXT", "text": "Je peux encore me rattraper.", "fact_refs": [], "beat_id": "attitude_choice", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m30", "speaker_id": "sandra", "kind": "TEXT", "text": "Je regarde ça.", "fact_refs": [], "beat_id": "attitude_choice", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m31", "speaker_id": "sandra", "kind": "TEXT", "text": "D'accord… je pensais vraiment que tu faisais juste le malin.", "fact_refs": ["last_lunch_photo"], "beat_id": "local_reception", "branch": "careful_warmth", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m32", "speaker_id": "sandra", "kind": "TEXT", "text": "C'est un peu gentil. Mal calibré, mais gentil.", "fact_refs": ["last_lunch_photo"], "beat_id": "local_reception", "branch": "careful_warmth", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m33", "speaker_id": "sandra", "kind": "TEXT", "text": "Voilà. Sauvés par la frite.", "fact_refs": ["cold_fries_joke"], "beat_id": "local_reception", "branch": "ironic_withdrawal", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m34", "speaker_id": "sandra", "kind": "TEXT", "text": "J'allais finir par croire que tu devenais presque sérieux.", "fact_refs": ["cold_fries_joke"], "beat_id": "local_reception", "branch": "ironic_withdrawal", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m35", "speaker_id": "marie", "kind": "TEXT", "text": "Verdict commun : on ne retourne pas dans ce restaurant.", "fact_refs": ["last_lunch_photo"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m36", "speaker_id": "player", "kind": "TEXT", "text": "Décision raisonnable.", "fact_refs": ["last_lunch_photo"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m37", "speaker_id": "sandra", "kind": "TEXT", "text": "Pour une fois.", "fact_refs": [], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": null, "strength": "WEAK", "media": null},
    {"message_id": "m38", "speaker_id": "marie", "kind": "TEXT", "text": "Je garde quand même la photo.", "fact_refs": ["last_lunch_photo"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m39", "speaker_id": "sandra", "kind": "TEXT", "text": "Pour ton dossier sur les verres dangereux ?", "fact_refs": ["cracked_glass_detail"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m40", "speaker_id": "marie", "kind": "TEXT", "text": "Pour la lumière.", "fact_refs": ["last_lunch_photo"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": "burst_marie", "strength": "NORMAL", "media": null},
    {"message_id": "m41", "speaker_id": "marie", "kind": "TEXT", "text": "Et vos têtes.", "fact_refs": ["last_lunch_photo"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": "burst_marie", "strength": "NORMAL", "media": null},
    {"message_id": "m42", "speaker_id": "marie", "kind": "TEXT", "text": "Surtout vos têtes.", "fact_refs": ["last_lunch_photo"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": "burst_marie", "strength": "NORMAL", "media": null},
    {"message_id": "m43", "speaker_id": "sandra", "kind": "TEXT", "text": "Je retire ce que j'ai dit sur ton talent.", "fact_refs": ["lunch_photo_taken_by_marie"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m44", "speaker_id": "player", "kind": "TEXT", "text": "Trop tard, c'est archivé.", "fact_refs": ["last_lunch_photo"], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m45", "speaker_id": "sandra", "kind": "TEXT", "text": "Évidemment.", "fact_refs": [], "beat_id": "allowed_convergence", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m46", "speaker_id": "marie", "kind": "TEXT", "text": "Au fait, question moins noble.", "fact_refs": ["bread_for_tonight"], "beat_id": "ordinary_close", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m47", "speaker_id": "marie", "kind": "TEXT", "text": "Tu peux prendre du pain en rentrant, le petit complet si la boulangerie en a encore, sinon n'importe quoi qui ne soit pas cette baguette sèche de mardi ?", "fact_refs": ["bread_for_tonight"], "beat_id": "ordinary_close", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m48", "speaker_id": "player", "kind": "TEXT", "text": "Le petit complet. Compris.", "fact_refs": ["bread_for_tonight"], "beat_id": "ordinary_close", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null},
    {"message_id": "m49", "speaker_id": "sandra", "kind": "TEXT", "text": "Fin de l'élégie.", "fact_refs": [], "beat_id": "ordinary_close", "branch": "COMMON", "burst_id": null, "strength": "WEAK", "media": null},
    {"message_id": "m50", "speaker_id": "marie", "kind": "TEXT", "text": "Retour à la vraie vie 🙂", "fact_refs": ["bread_for_tonight"], "beat_id": "ordinary_close", "branch": "COMMON", "burst_id": null, "strength": "NORMAL", "media": null}
  ],
