            {"id": "msg_j11_sandra_desire_002", "sender": "sandra", "time_label": "21:22", "text": "C’est pour ça que j’ai hésité."},
            {"id": "msg_j11_sandra_desire_003", "sender": "sandra", "time_label": "21:23", "text": "Et c’est pour ça que je l’ai envoyée quand même."},
            {"id": "msg_j11_sandra_desire_player", "sender": "player", "time_label": "21:23", "text": "je ne fais rien avec sans que tu me le dises"},
            {"id": "msg_j11_sandra_desire_004", "sender": "sandra", "time_label": "21:24", "text": "Bien."},
            {"id": "msg_j11_sandra_desire_005", "sender": "sandra", "time_label": "21:24", "text": "Je ne sais pas encore si ça me rassure ou si ça rend le geste plus réel."}
