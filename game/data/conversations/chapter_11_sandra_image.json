      "choices": [
        {
          "id": "choice_j11_sandra_rule",
          "text": "tu veux que je la voie seulement ou je peux la garder",
          "next_messages": [
            {"id": "msg_j11_sandra_rule_001", "sender": "sandra", "time_label": "21:22", "text": "Merci de demander."},
