            {"id": "msg_j11_sandra_rule_003", "sender": "sandra", "time_label": "21:23", "text": "Pas l’enregistrer ailleurs."},
            {"id": "msg_j11_sandra_rule_004", "sender": "sandra", "time_label": "21:23", "text": "Pas la montrer."},
            {"id": "msg_j11_sandra_rule_guided", "sender": "player", "time_label": "21:23", "text": "d’accord"},
            {"id": "msg_j11_sandra_rule_005", "sender": "sandra", "time_label": "21:24", "text": "Je vais probablement vérifier demain si tu as compris."}
          ]
        },
        {
          "id": "choice_j11_sandra_desire",
          "text": "tu savais que j’allais la regarder longtemps",
