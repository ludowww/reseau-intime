        {"id": "msg_j11_sandra_002", "sender": "sandra", "time_label": "21:19", "text": "Niveau raisonnable."},
        {"id": "msg_j11_sandra_003", "sender": "sandra", "time_label": "21:19", "text": "J’ai pris des photos avant de sortir."},
        {"id": "msg_j11_sandra_004", "sender": "sandra", "time_label": "21:20", "text": "Je n’en ai gardé qu’une."},
        {"id": "msg_j11_sandra_005", "sender": "sandra", "time_label": "21:21", "text": "Celle-là."},
