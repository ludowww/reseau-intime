            {"id": "msg_j10_mathilde_precise_001", "sender": "mathilde", "time_label": "17:18", "text": "Bon."},
            {"id": "msg_j10_mathilde_precise_002", "sender": "mathilde", "time_label": "17:18", "text": "C’est exactement ce que je pensais."},
            {"id": "msg_j10_mathilde_precise_003", "sender": "mathilde", "time_label": "17:18", "text": "J’avais changé la veste après l’autre matin."},
            {"id": "msg_j10_mathilde_precise_004", "sender": "mathilde", "time_label": "17:19", "text": "Je voulais voir si tu le remarquerais."},
            {"id": "msg_j10_mathilde_precise_005", "sender": "mathilde", "time_label": "17:19", "text": "Ne prends pas trop confiance."}
          ]
        },
        {
          "id": "choice_j10_mathilde_effect",
          "text": "tu sais très bien que la première me fera regarder",
