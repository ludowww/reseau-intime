            {"id": "msg_j10_mathilde_effect_003", "sender": "mathilde", "time_label": "17:19", "text": "Et ne pars pas trop loin avec ça."},
            {"id": "msg_j10_mathilde_effect_004", "sender": "mathilde", "time_label": "17:19", "text": "Mais oui. Je l’avais un peu choisie pour l’effet."}
          ]
        },
        {
          "id": "choice_j10_mathilde_weather",
          "text": "la deuxième. et prends une veste, il va pleuvoir",
          "next_messages": [
            {"id": "msg_j10_mathilde_weather_001", "sender": "mathilde", "time_label": "17:18", "text": "Merci papa."},
            {"id": "msg_j10_mathilde_weather_002", "sender": "mathilde", "time_label": "17:18", "text": "Je demandais aussi si tu remarquerais la première."},
            {"id": "msg_j10_mathilde_weather_003", "sender": "mathilde", "time_label": "17:19", "text": "Mais on peut garder la réponse météo."},
            {"id": "msg_j10_mathilde_weather_004", "sender": "mathilde", "time_label": "17:19", "text": "C’est plus simple."}
