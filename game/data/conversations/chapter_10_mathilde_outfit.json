        {"id": "msg_j10_mathilde_open_001", "sender": "mathilde", "time_label": "17:14", "text": "Question vêtement."},
        {"id": "msg_j10_mathilde_open_002", "sender": "mathilde", "time_label": "17:14", "text": "Inès me rejoint dans une heure."},
        {"id": "msg_j10_mathilde_open_003", "sender": "mathilde", "time_label": "17:15", "text": "J’hésite entre deux."},
        {"id": "msg_j10_mathilde_open_004", "sender": "mathilde", "time_label": "17:15", "text": "Je t’envoie avant de lui demander."},
        {"id": "msg_j10_mathilde_open_005", "sender": "mathilde", "time_label": "17:15", "text": "C’est probablement une mauvaise idée."},
