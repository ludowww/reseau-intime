        {"id":"choice_j12_nico_observe","text":"tu as remarqué quelque chose","next_messages":[{"id":"msg_j12_nico_observe_001","sender":"nico","time_label":"23:03","text":"Oui."},{"id":"msg_j12_nico_observe_002","sender":"nico","time_label":"23:03","text":"Et je ne vais pas l’utiliser pendant qu’elles sont là."}]},
        {"id":"choice_j12_nico_refuse","text":"je n’ai pas besoin que tu me surveilles","next_messages":[{"id":"msg_j12_nico_refuse_001","sender":"nico","time_label":"23:03","text":"Alors on ferme le garde-fou."},{"id":"msg_j12_nico_refuse_002","sender":"nico","time_label":"23:03","text":"Mais je ne deviens pas ton alibi."}]}
