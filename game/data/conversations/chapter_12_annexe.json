    {"id":"j12_after_sandra_clear","messages":[{"id":"msg_j12_sandra_after_clear_001","sender":"sandra","time_label":"00:28","text":"Merci d’avoir répondu sans transformer la photo publique en comparaison."},{"id":"msg_j12_sandra_after_clear_guided","sender":"player","time_label":"00:28","text":"ce n’était pas la même image ni la même règle"},{"id":"msg_j12_sandra_after_clear_002","sender":"sandra","time_label":"00:29","text":"Oui."},{"id":"msg_j12_sandra_after_clear_003","sender":"sandra","time_label":"00:29","text":"C’est exactement ce que je voulais vérifier."}],"choices":[]},
    {"id":"j12_after_sandra_delayed","messages":[{"id":"msg_j12_sandra_after_delayed_001","sender":"sandra","time_label":"00:28","text":"Tu as répondu à l’heure."},{"id":"msg_j12_sandra_after_delayed_002","sender":"sandra","time_label":"00:28","text":"J’avais juste besoin de cette phrase."}],"choices":[]},
    {"id":"j12_after_sandra_exit","messages":[{"id":"msg_j12_sandra_after_exit_001","sender":"sandra","time_label":"00:28","text":"Tu n’avais pas besoin de sortir pour ça."},{"id":"msg_j12_sandra_after_exit_002","sender":"sandra","time_label":"00:28","text":"Mais tu as gardé la règle. Bonne nuit."}],"choices":[]},
    {"id":"j12_after_mathilde","messages":[{"id":"msg_j12_mathilde_after_001","sender":"mathilde","time_label":"00:28","text":"On a été très normaux."},{"id":"msg_j12_mathilde_after_002","sender":"mathilde","time_label":"00:28","text":"Nico a quand même regardé deux fois si on s’évitait."},{"id":"msg_j12_mathilde_after_guided","sender":"player","time_label":"00:29","text":"il ne sait rien"},{"id":"msg_j12_mathilde_after_003","sender":"mathilde","time_label":"00:29","text":"Non. Mais il sait qu’il y a quelque chose à ne pas savoir."},{"id":"msg_j12_mathilde_after_004","sender":"mathilde","time_label":"00:30","text":"Demain, il faut qu’on décide comment on vit dans l’appartement."}],"choices":[]},
    {"id":"j12_after_mathilde_look","messages":[{"id":"msg_j12_mathilde_look_after_001","sender":"mathilde","time_label":"00:28","text":"La soirée était ordinaire."},{"id":"msg_j12_mathilde_look_after_002","sender":"mathilde","time_label":"00:28","text":"C’était très bien comme ça."}],"choices":[]},
    {"id":"j12_after_mathilde_m_b1","messages":[{"id":"msg_j12_mathilde_m_b1_after_001","sender":"mathilde","time_label":"00:28","text":"On a réussi à être dans la même pièce sans rendre ça bizarre."},{"id":"msg_j12_mathilde_m_b1_after_002","sender":"mathilde","time_label":"00:28","text":"Ça compte. Mais ça ne décide rien pour la suite."}],"choices":[]},
    {"id":"j12_after_mathilde_m_b2","messages":[{"id":"msg_j12_mathilde_m_b2_after_001","sender":"mathilde","time_label":"00:28","text":"On a tenu la limite d’hier et celle d’aujourd’hui."},{"id":"msg_j12_mathilde_m_b2_after_002","sender":"mathilde","time_label":"00:29","text":"Ça ne veut pas dire qu’il y aura une suite demain."}],"choices":[]},
    {"id":"j12_after_mathilde_clean_stop","messages":[{"id":"msg_j12_mathilde_clean_stop_after_001","sender":"mathilde","time_label":"00:28","text":"Merci de ne pas avoir insisté."},{"id":"msg_j12_mathilde_clean_stop_after_002","sender":"mathilde","time_label":"00:28","text":"Bonne nuit."}],"choices":[]},
    {"id":"j12_after_raphaelle_first_kiss","messages":[{"id":"msg_j12_raphaelle_after_kiss_001","sender":"raphaelle","time_label":"00:28","text":"Hier n’était pas le rôle."},{"id":"msg_j12_raphaelle_after_kiss_002","sender":"raphaelle","time_label":"00:29","text":"Merci de ne pas l’avoir rejoué devant tout le monde."},{"id":"msg_j12_raphaelle_after_kiss_003","sender":"raphaelle","time_label":"00:29","text":"Ça ne décide pas la suite."}],"choices":[]},
    {"id":"j12_after_raphaelle_attraction","messages":[{"id":"msg_j12_raphaelle_after_attraction_001","sender":"raphaelle","time_label":"00:28","text":"Ce qu’on s’est dit hier reste vrai."},{"id":"msg_j12_raphaelle_after_attraction_002","sender":"raphaelle","time_label":"00:29","text":"Merci de ne pas avoir essayé d’en faire davantage ce soir."}],"choices":[]},
