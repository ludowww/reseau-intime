    {"id":"j12_after_sandra","messages":[{"id":"msg_j12_sandra_after_001","sender":"sandra","time_label":"00:28","text":"Merci d’avoir répondu sans transformer la photo publique en comparaison."},{"id":"msg_j12_sandra_after_guided","sender":"player","time_label":"00:28","text":"ce n’était pas la même image ni la même règle"},{"id":"msg_j12_sandra_after_002","sender":"sandra","time_label":"00:29","text":"Oui."},{"id":"msg_j12_sandra_after_003","sender":"sandra","time_label":"00:29","text":"C’est exactement ce que je voulais vérifier."}],"choices":[]},
    {"id":"j12_after_mathilde","messages":[{"id":"msg_j12_mathilde_after_001","sender":"mathilde","time_label":"00:28","text":"On a été très normaux."},{"id":"msg_j12_mathilde_after_002","sender":"mathilde","time_label":"00:28","text":"Nico a quand même regardé deux fois si on s’évitait."},{"id":"msg_j12_mathilde_after_guided","sender":"player","time_label":"00:29","text":"il ne sait rien"},{"id":"msg_j12_mathilde_after_003","sender":"mathilde","time_label":"00:29","text":"Non. Mais il sait qu’il y a quelque chose à ne pas savoir."},{"id":"msg_j12_mathilde_after_004","sender":"mathilde","time_label":"00:30","text":"Demain, il faut qu’on décide comment on vit dans l’appartement."}],"choices":[]},
    {"id":"j12_after_mathilde_look","messages":[{"id":"msg_j12_mathilde_look_after_001","sender":"mathilde","time_label":"00:28","text":"La soirée était ordinaire."},{"id":"msg_j12_mathilde_look_after_002","sender":"mathilde","time_label":"00:28","text":"C’était très bien comme ça."}],"choices":[]},
    {"id":"j12_after_mathilde_m_b1","messages":[{"id":"msg_j12_mathilde_m_b1_after_001","sender":"mathilde","time_label":"00:28","text":"On a réussi à être dans la même pièce sans rendre ça bizarre."},{"id":"msg_j12_mathilde_m_b1_after_002","sender":"mathilde","time_label":"00:28","text":"Ça compte. Mais ça ne décide rien pour la suite."}],"choices":[]},
    {"id":"j12_after_mathilde_m_b2","messages":[{"id":"msg_j12_mathilde_m_b2_after_001","sender":"mathilde","time_label":"00:28","text":"On a tenu la limite d’hier et celle d’aujourd’hui."},{"id":"msg_j12_mathilde_m_b2_after_002","sender":"mathilde","time_label":"00:29","text":"Ça ne veut pas dire qu’il y aura une suite demain."}],"choices":[]},
    {"id":"j12_after_mathilde_clean_stop","messages":[{"id":"msg_j12_mathilde_clean_stop_after_001","sender":"mathilde","time_label":"00:28","text":"Merci de ne pas avoir insisté."},{"id":"msg_j12_mathilde_clean_stop_after_002","sender":"mathilde","time_label":"00:28","text":"Bonne nuit."}],"choices":[]},
    {"id":"j12_after_raphaelle","messages":[{"id":"msg_j12_raphaelle_after_001","sender":"raphaelle","time_label":"00:28","text":"Merci de ne pas avoir essayé de faire exister la version privée dans la salle."},{"id":"msg_j12_raphaelle_after_guided","sender":"player","time_label":"00:28","text":"ce n’était pas le lieu"},{"id":"msg_j12_raphaelle_after_002","sender":"raphaelle","time_label":"00:29","text":"Oui."},{"id":"msg_j12_raphaelle_after_003","sender":"raphaelle","time_label":"00:29","text":"Dimanche, je te dirai si je veux qu’elle existe encore ailleurs."}],"choices":[]},
    {"id":"j12_after_nico","messages":[{"id":"msg_j12_nico_after_001","sender":"nico","time_label":"00:28","text":"La règle a tenu."},{"id":"msg_j12_nico_after_002","sender":"nico","time_label":"00:28","text":"Tu n’as pas parlé pour elles. Moi non plus."},{"id":"msg_j12_nico_after_guided","sender":"player","time_label":"00:29","text":"ça devrait être la base"},{"id":"msg_j12_nico_after_003","sender":"nico","time_label":"00:29","text":"Oui. Maintenant on sait qu’on peut la tenir quand elles sont vraiment là."}],"choices":[]},
    {"id":"j12_after_marie","messages":[{"id":"msg_j12_marie_after_001","sender":"marie","time_label":"00:28","text":"On avait l’air d’un couple ce soir."},{"id":"msg_j12_marie_after_guided","sender":"player","time_label":"00:28","text":"on en est un"},{"id":"msg_j12_marie_after_002","sender":"marie","time_label":"00:29","text":"Oui."},{"id":"msg_j12_marie_after_003","sender":"marie","time_label":"00:29","text":"La question, c’est ce qu’on fait quand personne ne prend la photo."}],"choices":[]},
    {"id":"j12_after_marie_non_adult","messages":[{"id":"msg_j12_marie_non_adult_after_001","sender":"marie","time_label":"00:28","text":"Ce soir n’avait pas besoin de prouver davantage."},{"id":"msg_j12_marie_non_adult_after_002","sender":"marie","time_label":"00:29","text":"La confiance tient mieux quand on ne force pas la suite."}],"choices":[]},
    {"id":"j12_after_marie_no_bandage","messages":[{"id":"msg_j12_marie_no_bandage_after_001","sender":"marie","time_label":"00:28","text":"Merci de ne pas avoir transformé la soirée en preuve."},{"id":"msg_j12_marie_no_bandage_after_002","sender":"marie","time_label":"00:29","text":"On garde la distinction. On garde aussi le désir."}],"choices":[]},
    {"id":"j12_after_marie_distance","messages":[{"id":"msg_j12_marie_distance_after_001","sender":"marie","time_label":"00:28","text":"On a été très bien en public."},{"id":"msg_j12_marie_distance_after_002","sender":"marie","time_label":"00:29","text":"Je ne vais pas faire semblant que cela répond au reste."}],"choices":[]},
