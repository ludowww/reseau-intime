          {"id": "msg_j11_mathilde_proximity_003", "sender": "mathilde", "time_label": "21:11", "text": "Et demain tu ne me fais pas un débrief de trois pages."},
          {"id": "msg_j11_mathilde_proximity_player_002", "sender": "player", "time_label": "21:11", "text": "d’accord"}
