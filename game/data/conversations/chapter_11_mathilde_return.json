          {"id": "msg_j11_mathilde_distance_002", "sender": "mathilde", "time_label": "21:11", "text": "Je vais quand même chercher de l’eau."},
          {"id": "msg_j11_mathilde_distance_003", "sender": "mathilde", "time_label": "21:11", "text": "Mais je ne transforme pas le trajet en scène."},
