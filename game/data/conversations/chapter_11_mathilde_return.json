        {"id": "msg_j11_mathilde_001", "sender": "mathilde", "time_label": "21:06", "text": "Je suis en bas."},
        {"id": "msg_j11_mathilde_002", "sender": "mathilde", "time_label": "21:06", "text": "Je remonte dans deux minutes."},
        {"id": "msg_j11_mathilde_003", "sender": "mathilde", "time_label": "21:06", "text": "Et je porte la première tenue."},
        {"id": "msg_j11_mathilde_004", "sender": "mathilde", "time_label": "21:07", "text": "Oui, exprès."},
        {"id": "msg_j11_mathilde_005", "sender": "mathilde", "time_label": "21:07", "text": "Je préfère te prévenir avant de voir ta tête."},
        {"id": "msg_j11_mathilde_guided", "sender": "player", "time_label": "21:07", "text": "j’ai compris"},
        {"id": "msg_j11_mathilde_006", "sender": "mathilde", "time_label": "21:08", "text": "Tu as compris une partie."},
        {"id": "msg_j11_mathilde_007", "sender": "mathilde", "time_label": "21:08", "text": "Je veux que tu regardes."},
        {"id": "msg_j11_mathilde_008", "sender": "mathilde", "time_label": "21:09", "text": "Le reste, je ne l’ai pas décidé."}
