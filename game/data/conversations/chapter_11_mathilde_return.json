          {"id": "msg_j11_mathilde_look_002", "sender": "mathilde", "time_label": "21:10", "text": "C’est exactement ce que je voulais savoir."},
          {"id": "msg_j11_mathilde_look_003", "sender": "mathilde", "time_label": "21:11", "text": "Et ça me met beaucoup plus mal à l’aise que prévu."}
        ]},
        {"id": "choice_j11_mathilde_proximity", "text": "viens. si tu veux que je m’approche, tu me le dis. sinon je garde mes mains", "next_messages": [
