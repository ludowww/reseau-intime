          "next_messages": [
            {"id": "msg_j07_nico_confidence_004", "sender": "nico", "time_label": "22:48", "text": "De toi, malheureusement."},
            {"id": "msg_j07_nico_confidence_005_marie_well", "sender": "nico", "time_label": "22:48", "variant": "marie_well_asked", "text": "Vendredi, tu m’as demandé si Marie avait l’air bien."},
            {"id": "msg_j07_nico_confidence_005_chair", "sender": "nico", "time_label": "22:48", "variant": "chair_return", "text": "Vendredi, on parlait d’une chaise et tu as quand même fini par revenir à Marie."},
            {"id": "msg_j07_nico_confidence_006", "sender": "nico", "time_label": "22:49", "text": "Pas si elle t’en voulait."},
            {"id": "msg_j07_nico_confidence_007", "sender": "nico", "time_label": "22:49", "text": "Si elle avait l’air bien."}
          ]
