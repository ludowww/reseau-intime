          "next_messages": [
            {"id": "msg_j07_nico_confidence_010b", "sender": "nico", "time_label": "22:52", "text": "Que tu regardes Marie quand elle parle aux autres."},
            {"id": "msg_j07_nico_confidence_011b", "sender": "nico", "time_label": "22:52", "text": "Pas comme un mec qui s’ennuie."},
            {"id": "msg_j07_nico_confidence_012b", "sender": "nico", "time_label": "22:53", "text": "Comme un mec qui vérifie si elle a encore besoin de lui."},
            {"id": "msg_j07_nico_confidence_013b", "sender": "nico", "time_label": "22:53", "text": "Et tu réponds vite dès que Mathilde entre dans la conversation."},
            {"id": "msg_j07_nico_confidence_014b_player", "sender": "player", "time_label": "22:54", "text": "tu lis beaucoup dans trois phrases"},
            {"id": "msg_j07_nico_confidence_015b", "sender": "nico", "time_label": "22:54", "text": "Possible."},
            {"id": "msg_j07_nico_confidence_016b", "sender": "nico", "time_label": "22:54", "text": "Je travaille avec des gens qui mentent sur leur dernière commande depuis six ans."},
            {"id": "msg_j07_nico_confidence_017b", "sender": "nico", "time_label": "22:55", "text": "Ça déforme."},
            {"id": "msg_j07_nico_confidence_018b", "sender": "nico", "time_label": "22:55", "text": "Et je préfère te prévenir."},
            {"id": "msg_j07_nico_confidence_019b", "sender": "nico", "time_label": "22:56", "text": "Marie me plaît."},
            {"id": "msg_j07_nico_confidence_020b", "sender": "nico", "time_label": "22:56", "text": "Mathilde aussi."},
            {"id": "msg_j07_nico_confidence_021b", "sender": "nico", "time_label": "22:56", "text": "Donc mon avis n’est pas neutre."}
          ]
        },
        {
          "id": "choice_j07_nico_stay_vague",
          "text": "j’ai juste la tête pleine. pas envie d’en faire une théorie",
          "tone": "confidence_declined",
          "next_messages": [
            {"id": "msg_j07_nico_confidence_010c", "sender": "nico", "time_label": "22:52", "text": "D’accord."},
            {"id": "msg_j07_nico_confidence_011c", "sender": "nico", "time_label": "22:52", "text": "Je vais pas te tirer les mots."},
            {"id": "msg_j07_nico_confidence_012c", "sender": "nico", "time_label": "22:53", "text": "Mais ne me demande pas un alibi un jour en prétendant que je n’avais rien compris."},
            {"id": "msg_j07_nico_confidence_013c_player", "sender": "player", "time_label": "22:54", "text": "je t’ai rien demandé"},
            {"id": "msg_j07_nico_confidence_014c", "sender": "nico", "time_label": "22:54", "text": "Justement."},
            {"id": "msg_j07_nico_confidence_015c", "sender": "nico", "time_label": "22:54", "text": "Je préfère être en avance."},
            {"id": "msg_j07_nico_confidence_016c", "sender": "nico", "time_label": "22:55", "text": "Et pour que ce soit clair : Marie me plaît."},
            {"id": "msg_j07_nico_confidence_017c", "sender": "nico", "time_label": "22:55", "text": "Mathilde aussi."},
            {"id": "msg_j07_nico_confidence_018c", "sender": "nico", "time_label": "22:56", "text": "Ça ne me donne rien."},
            {"id": "msg_j07_nico_confidence_019c", "sender": "nico", "time_label": "22:56", "text": "Mais je ne suis pas neutre."}
