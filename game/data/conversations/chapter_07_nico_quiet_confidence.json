            {"id": "msg_j07_nico_confidence_017a", "sender": "nico", "time_label": "22:55", "text": "Mathilde aussi. Pas de la même façon."},
            {"id": "msg_j07_nico_confidence_018a", "sender": "nico", "time_label": "22:55", "text": "Ça ne me donne rien."},
            {"id": "msg_j07_nico_confidence_019a", "sender": "nico", "time_label": "22:55", "text": "Mais mon avis n’est pas neutre."}
