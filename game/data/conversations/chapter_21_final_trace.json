  "segments":[
    {"id":"j21_morning_reconquest","messages":[{"id":"msg_j21_mr_001","sender":"marie","time_label":"07:42","text":"Il reste deux tomates."},{"id":"msg_j21_mr_002","sender":"marie","time_label":"07:43","text":"Un morceau de fromage."},{"id":"msg_j21_mr_003","sender":"marie","time_label":"07:43","text":"Et beaucoup moins d’optimisme que la dernière fois."},{"id":"msg_j21_mr_004","sender":"player","time_label":"07:44","text":"on peut acheter du pain"},{"id":"msg_j21_mr_005","sender":"marie","time_label":"07:44","text":"Voilà. C’est déjà mieux."},{"id":"msg_j21_mr_006","sender":"marie","time_label":"07:45","text":"Je finis à 19 h. Si tu dis que tu es là, sois là."}],"choices":[{"id":"choice_j21_morning_1930","text":"oui. 19 h 30","next_messages":[]},{"id":"choice_j21_morning_absent","text":"non. ne m’attends pas","next_messages":[]}]},
    {"id":"j21_morning_provisional","messages":[{"id":"msg_j21_mp_001","sender":"marie","time_label":"07:42","text":"J’ai pris le café dans la grande tasse."},{"id":"msg_j21_mp_002","sender":"marie","time_label":"07:43","text":"La petite était dans la chambre où tu dors. Phrase toujours étrange."},{"id":"msg_j21_mp_003","sender":"marie","time_label":"07:44","text":"Jeudi 20 h 30 tient toujours. Jusqu’à jeudi, notre règle tient aussi."}],"choices":[{"id":"choice_j21_morning_agree","text":"d’accord","next_messages":[]}]},
    {"id":"j21_morning_reconfiguration","messages":[{"id":"msg_j21_mn_001","sender":"marie","time_label":"07:42","text":"Je pars tôt. Élodie a déplacé la réunion sans déplacer la salle."},{"id":"msg_j21_mn_002","sender":"marie","time_label":"07:43","text":"On adore."},{"id":"msg_j21_mn_003","sender":"marie","time_label":"07:44","text":"Pour nous : aucune nouvelle étape avant jeudi 20 h 30."},{"id":"msg_j21_mn_004","sender":"marie","time_label":"07:45","text":"Je te le redis maintenant, pendant qu’on parle juste d’une réunion. Pas après un nouveau problème."}],"choices":[{"id":"choice_j21_morning_understood","text":"compris","next_messages":[]}]},
    {"id":"j21_morning_double","messages":[{"id":"msg_j21_md_001","sender":"marie","time_label":"07:42","text":"Tu rentres à quelle heure ?"}],"choices":[{"id":"choice_j21_morning_real_hour","text":"vers 20 h 15. je te préviens si ça change","next_messages":[{"id":"msg_j21_md_real","sender":"marie","time_label":"07:43","text":"D’accord."}]},{"id":"choice_j21_morning_vague","text":"pas tard","next_messages":[{"id":"msg_j21_md_vague","sender":"marie","time_label":"07:43","text":"Ce n’est pas une heure."}]},{"id":"choice_j21_morning_false_hour","text":"19 h 30","next_messages":[]}]},
    {"id":"j21_morning_fracture","messages":[{"id":"msg_j21_mf_001","sender":"marie","time_label":"07:42","text":"J’ai laissé la liste des dépenses sur la table."},{"id":"msg_j21_mf_002","sender":"marie","time_label":"07:43","text":"J’ai séparé les prélèvements que je pouvais identifier. Pour le reste, ajoute tes commentaires dans le document."}],"choices":[{"id":"choice_j21_morning_received","text":"reçu","next_messages":[{"id":"msg_j21_mf_ack","sender":"marie","time_label":"07:44","text":"Merci."}]}]},
    {"id":"j21_morning_separation","messages":[{"id":"msg_j21_ms_001","sender":"marie","time_label":"07:42","text":"J’ai mis tes dernières affaires dans deux cartons."},{"id":"msg_j21_ms_002","sender":"marie","time_label":"07:43","text":"Pas les livres. Je ne savais pas lesquels étaient à toi."},{"id":"msg_j21_ms_003","sender":"player","time_label":"07:44","text":"je passe quand"},{"id":"msg_j21_ms_004","sender":"marie","time_label":"07:44","text":"Mercredi 18 h 30. Une demi-heure."},{"id":"msg_j21_ms_005","sender":"marie","time_label":"07:45","text":"Si tu ne peux pas, on choisit une autre heure maintenant."}],"choices":[{"id":"choice_j21_boxes_accept","text":"mercredi 18 h 30","next_messages":[]},{"id":"choice_j21_boxes_refuse","text":"je ne peux pas mercredi","next_messages":[]}]},
    {"id":"j21_trace_sandra_kept","messages":[{"id":"msg_j21_ts_001","sender":"sandra","time_label":"12:07","text":"J’ai mis la photo dans le livre."},{"id":"msg_j21_ts_002","sender":"sandra","time_label":"12:08","text":"Celle du déjeuner. Pas l’autre."},{"id":"msg_j21_ts_003","sender":"sandra","time_label":"12:09","text":"Voilà. Je pensais que ça ferait plus de bruit."},{"id":"msg_j21_ts_004","sender":"sandra","time_label":"12:10","text":"En fait non."}],"choices":[]},
    {"id":"j21_trace_sandra_protective","messages":[{"id":"msg_j21_tsp_001","sender":"sandra","time_label":"12:07","text":"Je l’ai gardée. Pour moi."},{"id":"msg_j21_tsp_002","sender":"sandra","time_label":"12:08","text":"Je ne rouvre pas notre fil pour autant."}],"choices":[]},
    {"id":"j21_trace_sandra_broken","messages":[{"id":"msg_j21_tsb_001","sender":"sandra","time_label":"12:07","text":"La photo reste dans le livre."},{"id":"msg_j21_tsb_002","sender":"sandra","time_label":"12:08","text":"Ton accès, non."}],"choices":[]},
    {"id":"j21_trace_pauline_surface","messages":[{"id":"msg_j21_tp_001","sender":"pauline","time_label":"13:16","text":"J’ai remis les photos de la soirée dans le dossier."},{"id":"msg_j21_tp_002","sender":"pauline","time_label":"13:16","text":"La version publique uniquement."},{"id":"msg_j21_tp_003","sender":"pauline","time_label":"13:17","text":"Merci de ne pas transformer cette précision en invitation à poser des questions dans le groupe."}],"choices":[]},
    {"id":"j21_trace_pauline_protected","messages":[{"id":"msg_j21_tpp_001","sender":"pauline","time_label":"13:16","text":"Rien ne change à la règle."},{"id":"msg_j21_tpp_002","sender":"pauline","time_label":"13:17","text":"Ce n’est pas parce que c’est lundi que le compartiment est devenu une bonne idée."}],"choices":[]},
    {"id":"j21_trace_pauline_closed","messages":[{"id":"msg_j21_tpc_001","sender":"pauline","time_label":"13:16","text":"La photo publique est revenue dans le dossier."},{"id":"msg_j21_tpc_002","sender":"pauline","time_label":"13:17","text":"Le compartiment, non. Les deux phrases restent compatibles."}],"choices":[]},
    {"id":"j21_trace_raphaelle_active","messages":[{"id":"msg_j21_tr_001","sender":"raphaelle","time_label":"14:22","text":"J’ai remis le projet dans le dossier de fabrication."},{"id":"msg_j21_tr_002","sender":"raphaelle","time_label":"14:23","text":"Ton accès fonctionne toujours. L’image privée n’y est pas."},{"id":"msg_j21_tr_003","sender":"raphaelle","time_label":"14:24","text":"Je vérifie que les permissions sont restées dans les bonnes pièces."}],"choices":[]},
    {"id":"j21_trace_nico","messages":[{"id":"msg_j21_tn_001","sender":"nico","time_label":"15:04","text":"Tu ne peux plus m’utiliser comme preuve que ta version est vraie."},{"id":"msg_j21_tn_002","sender":"nico","time_label":"15:05","text":"Notre règle ne change pas parce qu’une photo existe."}],"choices":[]},
