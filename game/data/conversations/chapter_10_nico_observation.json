      "choices": [
        {
          "id": "choice_j10_nico_difference",
          "text": "chez nous Marie laisse plus de silences. Mathilde prend moins de place qu’elle le prétend",
          "next_messages": [
            {"id": "msg_j10_nico_difference_001", "sender": "nico", "time_label": "22:15", "text": "Ça ressemble à elles."},
            {"id": "msg_j10_nico_difference_002", "sender": "nico", "time_label": "22:15", "text": "Et je précise : je ne te demande pas de me montrer quoi que ce soit."},
            {"id": "msg_j10_nico_difference_003", "sender": "nico", "time_label": "22:16", "text": "Je voulais savoir si tu voyais une différence ou seulement un privilège."}
          ]
        },
        {
          "id": "choice_j10_nico_observation",
          "text": "qu’est-ce que tu as vu exactement",
          "next_messages": [
            {"id": "msg_j10_nico_observation_001", "sender": "nico", "time_label": "22:15", "text": "Marie bien dans la salle."},
            {"id": "msg_j10_nico_observation_002", "sender": "nico", "time_label": "22:15", "text": "Mathilde contente d’être remarquée et agacée de l’être."},
            {"id": "msg_j10_nico_observation_003", "sender": "nico", "time_label": "22:16", "text": "Et moi intéressé, donc pas neutre."},
            {"id": "msg_j10_nico_observation_004", "sender": "nico", "time_label": "22:16", "text": "C’est tout ce que je peux affirmer."}
          ]
        },
        {
          "id": "choice_j10_nico_close",
          "text": "je ne veux pas qu’on compare ce qu’elles sont dehors et chez moi",
          "next_messages": [
            {"id": "msg_j10_nico_close_001", "sender": "nico", "time_label": "22:15", "text": "D’accord."},
            {"id": "msg_j10_nico_close_002", "sender": "nico", "time_label": "22:15", "text": "Je ne redemande pas."},
            {"id": "msg_j10_nico_close_003", "sender": "nico", "time_label": "22:16", "text": "Et ce que tu m’as dit reste avec moi."}
