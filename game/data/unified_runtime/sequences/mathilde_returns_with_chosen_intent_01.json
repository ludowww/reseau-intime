  "beats": [
    {
      "beat_id": "mathilde_mb3_opening",
      "type": "MESSAGE",
      "content": {
        "thread_id": "mathilde_thread",
        "messages": [
          {"message_id": "mathilde_mb3_open_01", "author_id": "mathilde", "text": "Je suis en bas.", "diegetic_at": "2032-03-04T21:06:00+01:00", "relative_order": 0},
          {"message_id": "mathilde_mb3_open_02", "author_id": "mathilde", "text": "Je remonte dans deux minutes.", "diegetic_at": "2032-03-04T21:06:05+01:00", "relative_order": 1},
          {"message_id": "mathilde_mb3_open_03", "author_id": "mathilde", "text": "Et je porte la première tenue.", "diegetic_at": "2032-03-04T21:06:10+01:00", "relative_order": 2},
          {"message_id": "mathilde_mb3_open_04", "author_id": "mathilde", "text": "Oui, exprès.", "diegetic_at": "2032-03-04T21:07:00+01:00", "relative_order": 3},
          {"message_id": "mathilde_mb3_open_05", "author_id": "mathilde", "text": "Je préfère te prévenir avant de voir ta tête.", "diegetic_at": "2032-03-04T21:07:05+01:00", "relative_order": 4},
          {"message_id": "mathilde_mb3_open_06", "author_id": "player", "text": "j’ai compris", "diegetic_at": "2032-03-04T21:07:30+01:00", "relative_order": 5},
          {"message_id": "mathilde_mb3_open_07", "author_id": "mathilde", "text": "Tu as compris une partie.", "diegetic_at": "2032-03-04T21:08:00+01:00", "relative_order": 6},
          {"message_id": "mathilde_mb3_open_08", "author_id": "mathilde", "text": "Je veux que tu regardes.", "diegetic_at": "2032-03-04T21:08:05+01:00", "relative_order": 7},
          {"message_id": "mathilde_mb3_open_09", "author_id": "mathilde", "text": "Le reste, je ne l’ai pas décidé.", "diegetic_at": "2032-03-04T21:09:00+01:00", "relative_order": 8},
          {"message_id": "mathilde_mb3_consent_01", "author_id": "mathilde", "text": "Tu peux m’embrasser.", "diegetic_at": "2032-03-04T21:12:00+01:00", "relative_order": 9},
          {"message_id": "mathilde_mb3_consent_02", "author_id": "mathilde", "text": "Rien d’autre sans me demander.", "diegetic_at": "2032-03-04T21:12:05+01:00", "relative_order": 10},
          {"message_id": "mathilde_mb3_consent_03", "author_id": "player", "text": "je t’embrasse seulement. si tu veux autre chose, tu me le dis. tu peux arrêter quand tu veux", "diegetic_at": "2032-03-04T21:12:20+01:00", "relative_order": 11},
          {"message_id": "mathilde_mb3_consent_04", "author_id": "mathilde", "text": "Oui.", "diegetic_at": "2032-03-04T21:13:00+01:00", "relative_order": 12},
          {"message_id": "mathilde_mb3_consent_05", "author_id": "mathilde", "text": "Je veux aller plus loin que ça.", "diegetic_at": "2032-03-04T21:14:00+01:00", "relative_order": 13},
          {"message_id": "mathilde_mb3_consent_06", "author_id": "mathilde", "text": "Je te dis ce que j’accepte au fur et à mesure. Tu ne complètes pas le reste tout seul.", "diegetic_at": "2032-03-04T21:14:05+01:00", "relative_order": 14},
          {"message_id": "mathilde_mb3_consent_07", "author_id": "player", "text": "d’accord. tu décides chaque étape. si tu hésites, si tu changes d’avis ou si tu dis stop, on arrête", "diegetic_at": "2032-03-04T21:14:10+01:00", "relative_order": 15},
          {"message_id": "mathilde_mb3_consent_08", "author_id": "mathilde", "text": "Oui.", "diegetic_at": "2032-03-04T21:14:15+01:00", "relative_order": 16},
          {"message_id": "mathilde_mb3_consent_09", "author_id": "mathilde", "text": "Et après je dors ailleurs comme prévu.", "diegetic_at": "2032-03-04T21:14:20+01:00", "relative_order": 17},
          {"message_id": "mathilde_mb3_consent_10", "author_id": "player", "text": "compris", "diegetic_at": "2032-03-04T21:14:25+01:00", "relative_order": 18},
          {"message_id": "mathilde_mb3_consent_11", "author_id": "mathilde", "text": "Viens.", "diegetic_at": "2032-03-04T21:14:30+01:00", "relative_order": 19}
        ]
      },
