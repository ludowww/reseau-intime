        {"message_id": "sandra_warm_return_04", "author_id": "sandra", "text": "J'ai déjà passé trop de temps à choisir une photo que j'avais soi-disant juste retrouvée.", "diegetic_at": "2032-03-02T23:06:05+01:00", "relative_order": 3},
