      "messages": [
        {"message_id": "mathilde_mb3_ma1_return_01", "author_id": "mathilde", "text": "Bien.", "diegetic_at": "2032-03-04T21:53:00+01:00", "relative_order": 0},
        {"message_id": "mathilde_mb3_ma1_return_02", "author_id": "mathilde", "text": "Mais demain, tu ne fais pas comme si rien ne s’était passé.", "diegetic_at": "2032-03-04T21:53:05+01:00", "relative_order": 1}
      ]
    },
    {
