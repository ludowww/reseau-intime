        {"message_id": "mathilde_mb3_aftercare_01", "author_id": "mathilde", "text": "Je suis arrivée.", "diegetic_at": "2032-03-04T21:51:00+01:00", "relative_order": 0},
        {"message_id": "mathilde_mb3_aftercare_02", "author_id": "mathilde", "text": "Je ne regrette pas.", "diegetic_at": "2032-03-04T21:51:05+01:00", "relative_order": 1},
        {"message_id": "mathilde_mb3_aftercare_03", "author_id": "mathilde", "text": "Je ne sais pas encore ce que ça change.", "diegetic_at": "2032-03-04T21:52:00+01:00", "relative_order": 2}
