        {"message_id": "mathilde_mb3_failed_return_01", "author_id": "mathilde", "text": "Hier, tu as demandé la suite avant de vérifier comment j’étais.", "diegetic_at": "2032-03-05T09:06:00+01:00", "relative_order": 0},
        {"message_id": "mathilde_mb3_failed_return_02", "author_id": "mathilde", "text": "Je ne viens pas ce soir.", "diegetic_at": "2032-03-05T09:07:00+01:00", "relative_order": 1},
