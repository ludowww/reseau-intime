{
  "fixture_kind": "SYNTHETIC_NON_CANONICAL_INVALID_CASES",
  "cases": [
    {
      "case_id": "unknown_key",
      "target": "authored_sequence",
      "mutation": "add_root_unknown_key",
      "expected_error": "root.unexpected: unknown_field"
    },
    {
      "case_id": "missing_required_field",
      "target": "authored_sequence",
      "mutation": "remove_entry_beat_id",
      "expected_error": "root.entry_beat_id: missing_required_field"
    },
    {
      "case_id": "forbidden_beat_type",
      "target": "authored_sequence",
      "mutation": "set_forbidden_beat_type",
      "expected_error": "unknown_beat_type"
    },
    {
      "case_id": "duplicate_identifier",
      "target": "authored_sequence",
      "mutation": "duplicate_beat_id",
      "expected_error": "duplicate"
    },
    {
      "case_id": "missing_transition_target",
      "target": "authored_sequence",
      "mutation": "set_unknown_direct_target",
      "expected_error": "unknown_beat"
    },
    {
      "case_id": "missing_resolution",
      "target": "authored_sequence",
      "mutation": "set_unknown_choice_resolution",
      "expected_error": "unknown_resolution"
    },
    {
      "case_id": "missing_media",
      "target": "authored_sequence",
      "mutation": "set_unknown_media_reference",
      "expected_error": "unknown_media"
    },
    {
      "case_id": "missing_checkpoint",
      "target": "authored_sequence",
      "mutation": "set_unknown_terminal_checkpoint",
      "expected_error": "unknown_checkpoint"
    },
    {
      "case_id": "cycle",
      "target": "authored_sequence",
      "mutation": "create_return_cycle",
      "expected_error": "cycle_detected"
    },
    {
      "case_id": "day_based_identifier",
      "target": "authored_sequence",
      "mutation": "set_day_based_sequence_id",
      "expected_error": "day_based_identifier_forbidden"
    },
    {
      "case_id": "invalid_version",
      "target": "authored_sequence",
      "mutation": "set_invalid_authored_version",
      "expected_error": "expected_major_minor_patch"
    },
    {
      "case_id": "invalid_canonical_status",
      "target": "authored_sequence",
      "mutation": "set_invalid_canonical_status",
      "expected_error": "expected_canon_approved"
    },
    {
      "case_id": "legacy_field",
      "target": "authored_sequence",
      "mutation": "add_legacy_current_day",
      "expected_error": "root.current_day: unknown_field"
    },
    {
      "case_id": "execution_receipt_before_open",
      "target": "sequence_execution",
      "mutation": "add_receipt_without_open",
      "expected_error": "receipt_without_open"
    }
  ]
}
